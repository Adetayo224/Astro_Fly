# Astro_Fly environment variables
# Copy to .env.local and fill in. Every key is optional for local design work:
# without them the app runs in mock mode (in memory bookings, emails saved to .mock-emails, mock checkout).

# Public site URL, used in emails and payment callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the site and in emails
NEXT_PUBLIC_CONTACT_EMAIL=orders@samfredrobotics.com
# Deposit amount in naira offered at checkout
NEXT_PUBLIC_DEPOSIT_NGN=20000

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional extra owners. Normally people are managed in the dashboard Team tab (astrofly_team table)
ADMIN_EMAILS=

# Resend (resend.com > API keys). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Astro_Fly <orders@samfredrobotics.com>"
# SMTP (used first when set). With Resend: host smtp.resend.com, port 465, user resend, password = your Resend API key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=

# Where new booking alerts go
TEAM_EMAIL=orders@samfredrobotics.com

# Optional: Paystack online payments (inactive by default; customers pay by bank transfer)
PAYSTACK_SECRET_KEY=

# Credit line for a CC BY drone model in public/models (shown in the footer), for example:
# NEXT_PUBLIC_MODEL_CREDIT="DJI 3 mini Pro by wishmaster88 on Sketchfab, CC BY 4.0"
NEXT_PUBLIC_MODEL_CREDIT=

# Only for previewing a production build without Supabase: lets /admin open in demo mode.
ALLOW_DEMO_ADMIN=false
